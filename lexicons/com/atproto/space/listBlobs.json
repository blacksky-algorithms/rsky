{
  "lexicon": 1,
  "id": "com.atproto.space.listBlobs",
  "defs": {
    "main": {
      "type": "query",
      "description": "List the CIDs of blobs referenced by records in a permissioned repo, for a syncer mirroring them. Requires a covering OAuth scope or a space credential; implemented by a repo host.",
      "parameters": {
        "type": "params",
        "required": ["space", "repo"],
        "properties": {
          "space": {
            "type": "string",
            "description": "Permissioned space URI, in the form at://{authority}/space/{spaceType}/{skey}. Not a standard at-uri."
          },
          "repo": {
            "type": "string",
            "format": "did",
            "description": "The DID of the repo's author."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 500
          },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["cids"],
          "properties": {
            "cursor": { "type": "string" },
            "cids": {
              "type": "array",
              "items": { "type": "string", "format": "cid" }
            }
          }
        }
      },
      "errors": [{ "name": "RepoNotFound" }, { "name": "SpaceNotFound" }]
    }
  }
}
